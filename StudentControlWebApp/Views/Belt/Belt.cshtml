@{
    ViewData["Title"] = "Cinturones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Listado de Cinturones</h2>
<hr>
<p></p>
<div class="row">
    <div class="col-12">
        <table id="beltTable" data-toggle="table" class="table table-striped" data-side-pagination="server">
            <thead>
                <tr>
                    <th data-field="id">ID</th>
                    <th data-field="description">Color</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script type="text/javascript" src="@Url.Content("~/ProjectScripts/Belt.js")"></script>
}